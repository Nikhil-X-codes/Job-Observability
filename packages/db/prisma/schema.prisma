generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  RETRY_WAIT
  COMPLETED
  DEAD
  CANCELLED
}

enum JobType {
  GENERATE_REPORT
  SIMULATE_EMAIL
  MOCK_WEBHOOK
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum AttemptOutcome {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ErrorCode {
  TRANSIENT
  PERMANENT
  TIMEOUT
  LEASE_EXPIRED
  INTERNAL
}

enum OutboxStatus {
  PENDING
  SENT
  SUPERSEDED
}

model Tenant {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug  String @unique @db.VarChar(64)
  name  String @db.VarChar(120)
  users User[]
  jobs  Job[]

  @@map("tenants")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @db.VarChar(254)
  passwordHash String     @map("password_hash")
  role         Role       @default(MEMBER)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  sessions     Session[]
  events       JobEvent[]

  @@unique([tenantId, email])
  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Job {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  type           JobType
  payload        Json
  payloadHash    String           @map("payload_hash") @db.Char(64)
  idempotencyKey String?          @map("idempotency_key") @db.VarChar(128)
  priority       Priority         @default(NORMAL)
  status         JobStatus        @default(PENDING)
  runAt          DateTime         @map("run_at") @db.Timestamptz(3)
  nextRunAt      DateTime?        @map("next_run_at") @db.Timestamptz(3)
  maxAttempts    Int              @default(3) @map("max_attempts")
  attemptNumber  Int              @default(0) @map("attempt_number")
  leaseToken     String?          @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(3)
  replayOfId     String?          @map("replay_of_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  replayOf       Job?             @relation("JobReplays", fields: [replayOfId], references: [id])
  replays        Job[]            @relation("JobReplays")
  attempts       Attempt[]
  events         JobEvent[]
  outbox         OutboxEvent[]
  effects        BusinessEffect[]
  deadLetter     DeadLetter?      @relation("FailedJob")
  replayOfLetter DeadLetter?      @relation("ReplayedJob")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, nextRunAt, priority])
  @@index([status, leaseExpiresAt])
  @@index([replayOfId])
  @@map("jobs")
}

model Attempt {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String         @map("job_id") @db.Uuid
  attemptNo  Int            @map("attempt_no")
  workerId   String         @map("worker_id") @db.VarChar(128)
  startedAt  DateTime       @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?      @map("finished_at") @db.Timestamptz(3)
  outcome    AttemptOutcome @default(RUNNING)
  errorCode  ErrorCode?     @map("error_code")
  durationMs Int?           @map("duration_ms")
  job        Job            @relation(fields: [jobId], references: [id])

  @@unique([jobId, attemptNo])
  @@map("attempts")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic       String       @db.VarChar(64)
  aggregateId String       @map("aggregate_id") @db.Uuid
  attemptNo   Int          @map("attempt_no")
  body        Json
  status      OutboxStatus @default(PENDING)
  availableAt DateTime     @map("available_at") @db.Timestamptz(3)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  lockToken   String?      @map("lock_token") @db.Uuid
  lockedUntil DateTime?    @map("locked_until") @db.Timestamptz(3)
  retryCount  Int          @default(0) @map("retry_count")
  job         Job          @relation(fields: [aggregateId], references: [id])

  @@unique([topic, aggregateId, attemptNo])
  @@index([status, availableAt])
  @@map("outbox_events")
}

model JobEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(64)
  details    Json
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  job        Job      @relation(fields: [jobId], references: [id])
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, occurredAt, id])
  @@map("job_events")
}

model DeadLetter {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String    @unique @map("job_id") @db.Uuid
  lastErrorCode ErrorCode @map("last_error_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  replayedAt    DateTime? @map("replayed_at") @db.Timestamptz(3)
  replayJobId   String?   @unique @map("replay_job_id") @db.Uuid
  job           Job       @relation("FailedJob", fields: [jobId], references: [id])
  replayJob     Job?      @relation("ReplayedJob", fields: [replayJobId], references: [id])

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("dead_letters")
}

model BusinessEffect {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  effectKey String   @unique @map("effect_key") @db.VarChar(128)
  jobId     String   @map("job_id") @db.Uuid
  kind      JobType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  result    Json
  job       Job      @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("business_effects")
}
