JOBFLOW_DOMAIN=jobs.example.invalid
POSTGRES_PASSWORD=replace-with-a-unique-secret
RABBITMQ_PASSWORD=replace-with-a-different-unique-secret
DATABASE_URL=postgresql://jobflow:replace-with-encoded-postgres-password@postgres:5432/jobflow
AMQP_URL=amqp://jobflow:replace-with-encoded-rabbitmq-password@rabbitmq:5672/

